<Window x:Class="EquipmentMonitoring.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EquipmentMonitoring.App.Converters"
        Title="Мониторинг оборудования" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:StateToColorConverter x:Key="StateToColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель управления -->
        <StackPanel Grid.Column="0" Background="#f5f5f5">
            <TextBlock Text="Установки" Margin="10,10,10,5" FontWeight="Bold" FontSize="14"/>
            <ListBox ItemsSource="{Binding Equipments}" 
                     SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}"
                     DisplayMemberPath="Name" Margin="5"/>

            <Separator Margin="0,10"/>

            <Button Content="▶ Старт мониторинга" 
                    Command="{Binding StartMonitoringCommand}" 
                    Margin="10,5" Height="30"/>
            <Button Content="⏹ Стоп мониторинга" 
                    Command="{Binding StopMonitoringCommand}" 
                    Margin="10,5" Height="30"/>
            <Button Content="📊 Отчёт по отказам" 
                    Command="{Binding GenerateReportCommand}" 
                    Margin="10,5" Height="30"/>
            <!-- Новая кнопка сводного отчёта OEE -->
            <Button Content="📈 Сводный отчёт ОЕЕ" 
                    Command="{Binding GenerateOeeReportCommand}" 
                    Margin="10,5" Height="30"/>
        </StackPanel>

        <!-- Центральная область -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Индикаторы установок -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding Equipments}" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="120" Height="120" Margin="5"
                                Background="{Binding State, Converter={StaticResource StateToColorConverter}}"
                                CornerRadius="8" ToolTip="{Binding Name}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" 
                                           Foreground="White" TextWrapping="Wrap" 
                                           TextAlignment="Center" Margin="5"/>
                                <TextBlock Text="{Binding Installation}" 
                                           Foreground="#dddddd" FontSize="10"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Блок текущего OEE выбранного оборудования -->
            <StackPanel Grid.Row="1" Margin="10,5">
                <TextBlock Text="{Binding CurrentOeeText}" FontWeight="Bold" FontSize="16" />
                <WrapPanel>
                    <TextBlock Text="{Binding CurrentAvailabilityText}" Margin="0,0,15,0" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding CurrentPerformanceText}" Margin="0,0,15,0" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding CurrentQualityText}" FontSize="12" Foreground="Gray"/>
                </WrapPanel>
            </StackPanel>

            <!-- Таблица параметров -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedParameters}"
                      AutoGenerateColumns="False" Margin="10" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Параметр" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Значение" Binding="{Binding Value, StringFormat=N2}" Width="Auto"/>
                    <DataGridTextColumn Header="Ед.изм." Binding="{Binding Unit}" Width="Auto"/>
                    <DataGridTextColumn Header="Обновлено" Binding="{Binding Timestamp, StringFormat='dd.MM HH:mm:ss'}" Width="Auto"/>
                    <DataGridTemplateColumn Header="Тренд">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="📈" ToolTip="Показать тренд"
                                        Command="{Binding DataContext.ShowTrendCommand, 
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Правая панель: активные отказы -->
        <Grid Grid.Column="2" Background="#fafafa">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Активные отказы" Margin="10" FontWeight="Bold" FontSize="14"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding ActiveFaults}" Margin="5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="5" Margin="2" Background="#fff" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Description}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="{Binding Status, StringFormat='Статус: {0}'}" 
                                           Foreground="Gray" FontSize="12"/>
                                <Button Grid.Row="2" Content="Принять к работе"
                                        Command="{Binding DataContext.AcknowledgeFaultCommand, 
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,5,0,0" Height="25"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>